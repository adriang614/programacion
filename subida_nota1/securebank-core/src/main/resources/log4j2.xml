<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Muestra los logs en la consola -->
        <Console name="Consola" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%level] %msg%n"/>
        </Console>

        <!-- Guarda los logs en un archivo -->
        <File name="Archivo" fileName="logs/securebank.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%level] %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Consola"/>
            <AppenderRef ref="Archivo"/>
        </Root>
    </Loggers>
</Configuration>
